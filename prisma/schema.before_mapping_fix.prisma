// ============================================================================
// Legal ERP — Month 1 Prisma Schema
// Derived strictly from: Month-1 ERD Revision 1 + Clarification Addendum (locked/approved)
// No entities, relationships, or constraints introduced beyond what those documents specify.
//
// IMPORTANT — things Prisma's schema language cannot express natively, handled
// separately in migrations/0002_check_constraints_and_rls/migration.sql:
//   - CHECK constraints (Prisma has no @check attribute)
//   - Partial/filtered unique indexes (no WHERE clause support in schema.prisma)
//   - Row-Level Security policies (not a Prisma concept at all)
//   - The two cross-parent triggers from ERD §17.1 (role-scope / staff-only assignment)
// Everything Prisma CAN express natively — composite foreign keys for same-tenant
// integrity, ordinary unique/composite-unique constraints, nullability — is
// expressed directly below, not deferred to raw SQL.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// PLATFORM-LEVEL (no tenantId, no RLS) — ERD §11, §5b
// ----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  subdomain String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices           Office[]
  users             User[]
  roles             Role[]
  tenantFeatures    TenantFeature[]
  clients           Client[]
  contacts          Contact[]
  matters           Matter[]
  proceedings       Proceeding[]
  tenantCaseTypes   TenantCaseType[]
  assignments       Assignment[]
  conflictChecks    ConflictCheck[]
  conflictMatches   ConflictMatch[]
  auditLogs         AuditLog[]
  clientContacts    ClientContact[]
  matterParticipants MatterParticipant[]
  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  proceedingHistory ProceedingStatusHistory[]

  @@map("tenant")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  key         String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permission")
}

model Jurisdiction {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions Region[]

  @@map("jurisdiction")
}

model Region {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  jurisdictionId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction  @relation(fields: [jurisdictionId], references: [id])
  courtForums  CourtForum[]
  offices      Office[]

  @@unique([jurisdictionId, name])
  @@map("region")
}

model ForumType {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courtForums      CourtForum[]
  caseTypes        CaseType[]
  tenantCaseTypes  TenantCaseType[]

  @@map("forum_type")
}

model CourtForum {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  regionId    String
  forumTypeId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region      Region       @relation(fields: [regionId], references: [id])
  forumType   ForumType    @relation(fields: [forumTypeId], references: [id])
  benches     Bench[]
  proceedings Proceeding[]

  @@unique([regionId, forumTypeId, name])
  @@index([forumTypeId])
  @@map("court_forum")
}

model Bench {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  courtForumId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courtForum  CourtForum   @relation(fields: [courtForumId], references: [id])
  proceedings Proceeding[]

  @@unique([courtForumId, name])
  @@map("bench")
}

// NOTE: `is_tenant_extensible` deliberately removed per ERD Revision 1 (Point #5) —
// tenant-specific case types live in TenantCaseType below, not as a flag here.
model CaseType {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  forumTypeId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  forumType         ForumType        @relation(fields: [forumTypeId], references: [id])
  proceedings       Proceeding[]
  tenantCaseTypesBasedOn TenantCaseType[] @relation("TenantCaseTypeBasedOn")

  @@unique([forumTypeId, name])
  @@map("case_type")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Identity / RBAC / Entitlements — ERD §2-4, §5a-5d
// ----------------------------------------------------------------------------

model Office {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String
  name        String
  regionId    String?
  isPrimary   Boolean  @default(false)
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  region             Region?  @relation(fields: [regionId], references: [id])
  usersAsPrimary     User[]   @relation("UserPrimaryOffice")
  matters            Matter[]
  userRoles          UserRole[]

  @@unique([id, tenantId]) // supports composite FK from UserRole
  @@index([tenantId])
  @@map("office")
}

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId         String
  primaryOfficeId  String?
  email            String
  passwordHash     String
  userType         String   // 'staff' | 'client' — CHECK enforced in raw-SQL layer (ERD §17.1 Rule 3)
  fullName         String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  primaryOffice         Office?  @relation("UserPrimaryOffice", fields: [primaryOfficeId], references: [id])
  userRoles             UserRole[]
  assignments           Assignment[]
  auditLogsAsActor      AuditLog[]                 @relation("AuditLogActor")
  conflictChecksRun     ConflictCheck[]             @relation("ConflictCheckRunBy")
  conflictChecksCleared ConflictCheck[]             @relation("ConflictCheckClearedBy")
  conflictMatchesDecided ConflictMatch[]            @relation("ConflictMatchDecidedBy")
  mattersResponsible    Matter[]                    @relation("MatterResponsibleAttorney")
  proceedingStatusChanges ProceedingStatusHistory[] @relation("ProceedingStatusChangedBy")

  @@unique([tenantId, email])
  @@unique([id, tenantId]) // supports composite FKs from UserRole, Assignment, ConflictCheck, ConflictMatch, AuditLog, ProceedingStatusHistory
  @@index([tenantId])
  @@map("user")
}

model Role {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId            String
  name                String
  isSystemDefault     Boolean  @default(false)
  appliesToUserType   String   @default("staff") // 'staff' | 'client' — ERD §5a
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@unique([id, tenantId]) // supports composite FK from RolePermission, UserRole
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  tenantId     String
  roleId       String
  permissionId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId, tenantId], references: [id, tenantId]) // composite same-tenant FK, ERD §5b'
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([tenantId, roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  tenantId String
  userId   String
  roleId   String
  officeId String?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId, tenantId], references: [id, tenantId])   // composite same-tenant FK
  role   Role    @relation(fields: [roleId, tenantId], references: [id, tenantId])   // composite same-tenant FK
  office Office? @relation(fields: [officeId, tenantId], references: [id, tenantId]) // composite same-tenant FK, nullable

  @@unique([userId, roleId, officeId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_role")
}

model TenantFeature {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId   String
  featureKey String
  enabled    Boolean  @default(false)
  planTier   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureKey])
  @@map("tenant_feature")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Clients & Contacts — ERD §7, §8, §8a
// ----------------------------------------------------------------------------

model Client {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId         String
  clientType       String   // 'individual' | 'organization'
  displayName      String
  normalizedName   String   // ERD §7 — Month-1 transliteration-aware matching, single variant
  billingContactId String?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  billingContact  Contact?            @relation("ClientBillingContact", fields: [billingContactId], references: [id])
  matters         Matter[]
  clientContacts  ClientContact[]
  participantRows MatterParticipant[] @relation("ParticipantAsClient")
  conflictCheckTriggers ConflictCheck[]  @relation("ConflictTriggeredByClient")
  conflictMatches       ConflictMatch[]  @relation("ConflictMatchedClient")

  @@unique([id, tenantId]) // supports composite FKs from ClientContact, MatterParticipant, ConflictCheck, ConflictMatch (Revision-1 clarification, §3.1)
  @@index([tenantId])
  @@map("client")
}

model Contact {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId       String
  fullName       String
  normalizedName String   // ERD §8
  contactType    String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  clientsBilledFor      Client[]            @relation("ClientBillingContact")
  clientContacts        ClientContact[]
  participantRows       MatterParticipant[] @relation("ParticipantAsContact")
  conflictCheckTriggers ConflictCheck[]     @relation("ConflictTriggeredByContact")
  conflictMatches       ConflictMatch[]     @relation("ConflictMatchedContact")

  @@unique([id, tenantId]) // supports composite FKs (Revision-1 clarification, §3.1)
  @@index([tenantId])
  @@map("contact")
}

model ClientContact {
  id           String @id @default(dbgenerated("gen_random_uuid()"))
  tenantId     String
  clientId     String
  contactId    String
  relationship String

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [clientId, tenantId], references: [id, tenantId])  // composite same-tenant FK
  contact Contact @relation(fields: [contactId, tenantId], references: [id, tenantId]) // composite same-tenant FK

  @@unique([clientId, contactId, relationship])
  @@map("client_contact")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Matters, Participants, Proceedings — ERD §9, §9a, §10, §10a
// ----------------------------------------------------------------------------

model Matter {
  id                     String    @id @default(dbgenerated("gen_random_uuid()"))
  tenantId               String
  matterNumber           String
  title                  String
  clientId               String
  officeId               String
  practiceAreaId         String?
  responsibleAttorneyId  String?
  status                 String
  openedDate             DateTime?
  closedDate             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  client               Client              @relation(fields: [clientId], references: [id])
  office               Office              @relation(fields: [officeId], references: [id])
  responsibleAttorney  User?               @relation("MatterResponsibleAttorney", fields: [responsibleAttorneyId], references: [id])
  proceedings          Proceeding[]
  matterParticipants   MatterParticipant[]
  assignments          Assignment[]        @relation("AssignmentMatter")
  conflictCheckTriggers ConflictCheck[]    @relation("ConflictTriggeredByMatter")

  @@unique([tenantId, matterNumber])
  @@unique([id, tenantId]) // supports composite FKs from Proceeding, Assignment, MatterParticipant, ConflictCheck
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("matter")
}

model MatterParticipant {
  id          String  @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String
  matterId    String
  proceedingId String?
  contactId   String?
  clientId    String?
  role        String

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  matter     Matter      @relation(fields: [matterId, tenantId], references: [id, tenantId]) // composite same-tenant FK
  // Composite "same matter" FK — a referenced Proceeding must belong to this same Matter (ERD §9a).
  proceeding Proceeding? @relation(fields: [proceedingId, matterId], references: [id, matterId])
  contact    Contact?    @relation("ParticipantAsContact", fields: [contactId, tenantId], references: [id, tenantId])
  client     Client?     @relation("ParticipantAsClient", fields: [clientId, tenantId], references: [id, tenantId])

  // NOTE: the four partial unique indexes and the "exactly one of contactId/clientId"
  // CHECK from ERD §9a are not expressible here — see migrations/0002_.../migration.sql.
  @@index([tenantId, matterId])
  @@index([tenantId, proceedingId])
  @@map("matter_participant")
}

model Proceeding {
  id                        String    @id @default(dbgenerated("gen_random_uuid()"))
  tenantId                  String
  matterId                  String
  courtForumId              String
  benchId                   String?
  platformCaseTypeId        String?
  tenantCaseTypeId          String?
  caseNumber                String?
  filingDiaryNumber         String?
  filingDate                DateTime?
  externalCaseReferenceId   String?   // reserved for future eCourts/NJDG integration
  physicalFileLocation      String?   // reserved, structured free text for Month 1; see blueprint note
  status                    String
  proceedingCustomFields    Json?
  deletedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  matter             Matter                    @relation(fields: [matterId, tenantId], references: [id, tenantId]) // composite same-tenant FK
  courtForum         CourtForum                @relation(fields: [courtForumId], references: [id])
  bench              Bench?                    @relation(fields: [benchId], references: [id])
  platformCaseType   CaseType?                 @relation(fields: [platformCaseTypeId], references: [id])
  tenantCaseType     TenantCaseType?           @relation(fields: [tenantCaseTypeId, tenantId], references: [id, tenantId]) // composite same-tenant FK
  matterParticipants MatterParticipant[]
  statusHistory      ProceedingStatusHistory[]
  assignments        Assignment[]              @relation("AssignmentProceeding")
  conflictCheckTriggers ConflictCheck[]         @relation("ConflictTriggeredByProceeding")

  // NOTE: CHECK (exactly one of platformCaseTypeId / tenantCaseTypeId) and the
  // partial unique (tenantId, courtForumId, caseNumber) WHERE caseNumber IS NOT NULL
  // are not expressible here — see migrations/0002_.../migration.sql.
  @@unique([id, matterId])   // supports composite FK from MatterParticipant ("same matter" check)
  @@unique([id, tenantId])  // supports composite FKs from Assignment, ConflictCheck, ProceedingStatusHistory
  @@index([tenantId, matterId])
  @@index([tenantId, courtForumId])
  @@index([tenantId, status])
  @@map("proceeding")
}

model ProceedingStatusHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId         String
  proceedingId     String
  previousStatus   String?
  newStatus        String
  note             String?
  changedByUserId  String
  createdAt        DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  proceeding Proceeding @relation(fields: [proceedingId, tenantId], references: [id, tenantId]) // composite same-tenant FK
  changedBy  User       @relation("ProceedingStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, proceedingId, createdAt])
  @@map("proceeding_status_history")
}

model TenantCaseType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId            String
  forumTypeId         String
  basedOnCaseTypeId   String?
  name                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  forumType     ForumType     @relation(fields: [forumTypeId], references: [id])
  basedOnCaseType CaseType?   @relation("TenantCaseTypeBasedOn", fields: [basedOnCaseTypeId], references: [id])
  proceedings   Proceeding[]

  @@unique([tenantId, forumTypeId, name])
  @@unique([id, tenantId]) // supports composite FK from Proceeding
  @@map("tenant_case_type")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Assignment — ERD §12 (revised: nullable FKs, not polymorphic)
// ----------------------------------------------------------------------------

model Assignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  tenantId       String
  matterId       String?
  proceedingId   String?
  userId         String
  role           String
  effectiveFrom  DateTime
  effectiveTo    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  matter     Matter?     @relation("AssignmentMatter", fields: [matterId, tenantId], references: [id, tenantId])         // composite same-tenant FK
  proceeding Proceeding? @relation("AssignmentProceeding", fields: [proceedingId, tenantId], references: [id, tenantId]) // composite same-tenant FK
  user       User        @relation(fields: [userId, tenantId], references: [id, tenantId])                              // composite same-tenant FK

  // NOTE: CHECK (exactly one of matterId / proceedingId) and the staff-only
  // trigger on userId are not expressible here — see migration + RLS spike doc.
  @@index([tenantId, matterId])
  @@index([tenantId, proceedingId])
  @@index([tenantId, userId])
  @@map("assignment")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Conflicts Checking — ERD §13.2, §13.3 (revised: nullable FKs)
// ----------------------------------------------------------------------------

model ConflictCheck {
  id                       String    @id @default(dbgenerated("gen_random_uuid()"))
  tenantId                 String
  triggeredByClientId      String?
  triggeredByContactId     String?
  triggeredByMatterId      String?
  triggeredByProceedingId  String?
  searchName               String
  runByUserId              String
  clearedByUserId          String?
  clearedAt                DateTime?
  createdAt                DateTime  @default(now())

  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  triggeredByClient   Client?         @relation("ConflictTriggeredByClient", fields: [triggeredByClientId, tenantId], references: [id, tenantId])
  triggeredByContact  Contact?        @relation("ConflictTriggeredByContact", fields: [triggeredByContactId, tenantId], references: [id, tenantId])
  triggeredByMatter   Matter?         @relation("ConflictTriggeredByMatter", fields: [triggeredByMatterId, tenantId], references: [id, tenantId])
  triggeredByProceeding Proceeding?   @relation("ConflictTriggeredByProceeding", fields: [triggeredByProceedingId, tenantId], references: [id, tenantId])
  runBy               User            @relation("ConflictCheckRunBy", fields: [runByUserId, tenantId], references: [id, tenantId])
  clearedBy           User?           @relation("ConflictCheckClearedBy", fields: [clearedByUserId, tenantId], references: [id, tenantId])
  matches             ConflictMatch[]

  // NOTE: CHECK (exactly one of the four triggeredBy* columns) not expressible here.
  @@unique([id, tenantId]) // supports composite FK from ConflictMatch (Revision-1 clarification, §3.2)
  @@index([tenantId, createdAt])
  @@map("conflict_check")
}

model ConflictMatch {
  id               String  @id @default(dbgenerated("gen_random_uuid()"))
  tenantId         String
  conflictCheckId  String
  matchedClientId  String?
  matchedContactId String?
  similarityScore  Decimal
  decision         String  // 'flagged' | 'cleared' | 'unreviewed'
  decidedByUserId  String?

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  conflictCheck  ConflictCheck @relation(fields: [conflictCheckId, tenantId], references: [id, tenantId])
  matchedClient  Client?       @relation("ConflictMatchedClient", fields: [matchedClientId, tenantId], references: [id, tenantId])
  matchedContact Contact?      @relation("ConflictMatchedContact", fields: [matchedContactId, tenantId], references: [id, tenantId])
  decidedBy      User?         @relation("ConflictMatchDecidedBy", fields: [decidedByUserId, tenantId], references: [id, tenantId])

  // NOTE: CHECK (exactly one of matchedClientId / matchedContactId) not expressible here.
  @@index([tenantId, conflictCheckId])
  @@map("conflict_match")
}

// ----------------------------------------------------------------------------
// TENANT-SCOPED — Audit Log — ERD §15 (deliberate polymorphic exception)
// ----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId     String
  resourceType String
  resourceId   String   // deliberately NOT a native FK — see ERD §15 justification
  event        String
  actorId      String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation("AuditLogActor", fields: [actorId, tenantId], references: [id, tenantId])

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}
